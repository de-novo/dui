{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["src", "preview.mts", "vite.config.ts"]
}
