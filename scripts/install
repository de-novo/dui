#!/bin/sh
# Build dui from the latest SemVer release tag (vX.Y.Z) on the installing machine.
set -eu

fail() { printf 'dui: %s\n' "$*" >&2; exit 1; }

download() {
    curl -q --proto '=https' --proto-redir '=https' -fsSL --retry 2 -o "$2" "$1"
}

have_rust() { rustc --version >/dev/null 2>&1 && cargo --version >/dev/null 2>&1; }

prepare_rust() {
    if have_rust; then return; fi
    cargo_bin=${CARGO_HOME:-"$HOME/.cargo"}/bin
    if "$cargo_bin/rustc" --version >/dev/null 2>&1 && "$cargo_bin/cargo" --version >/dev/null 2>&1; then
        export PATH="$cargo_bin:$PATH"
        return
    fi

    printf '%s\n' 'dui: downloading a temporary Rust toolchain for this build' >&2
    export CARGO_HOME="$work/cargo" RUSTUP_HOME="$work/rustup" RUSTUP_TOOLCHAIN=stable
    download https://sh.rustup.rs "$work/rustup-init.sh"
    sh "$work/rustup-init.sh" -y --no-modify-path --profile minimal --default-toolchain stable >/dev/null
    export PATH="$CARGO_HOME/bin:$PATH"
}

prepare_node() {
    if [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)" = 26 ] &&
        npm --version >/dev/null 2>&1; then return; fi

    case $(uname -s) in Darwin) os=darwin ;; Linux) os=linux ;; esac
    case $(uname -m) in
        arm64|aarch64) arch=arm64 ;;
        x86_64) arch=x64 ;;
        ppc64le|s390x) arch=$(uname -m) ;;
        *) fail "install Node.js 26 and npm for $(uname -m), then retry" ;;
    esac
    if [ "$os" = linux ] && ldd --version 2>&1 | grep -qi musl; then arch="$arch-musl"; fi
    node_version=v26.13.1
    archive="node-$node_version-$os-$arch.tar.gz"
    dist="https://nodejs.org/dist/$node_version"
    printf '%s\n' 'dui: downloading temporary Node.js 26 and npm for this build' >&2
    download "$dist/SHASUMS256.txt" "$work/node-checksums"
    awk -v name="$archive" '$2 == name {print; found=1} END {exit !found}' "$work/node-checksums" > "$work/node.sha256" ||
        fail "no official Node.js build for $os-$arch; install Node.js 26 and npm, then retry"
    download "$dist/$archive" "$work/$archive"
    (cd "$work" && if command -v sha256sum >/dev/null; then sha256sum -c node.sha256; else shasum -a 256 -c node.sha256; fi)
    tar -xzf "$work/$archive" -C "$work"
    export PATH="$work/${archive%.tar.gz}/bin:$PATH"
}

resolve_latest_tag() {
    tag_refs=$(git ls-remote --tags --refs "$1" 'v*') || return 1
    latest=$(printf '%s\n' "$tag_refs" |
        awk '{ sub("^refs/tags/", "", $2); if ($2 ~ /^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/) print $2 }' |
        LC_ALL=C sort -t. -k1.2,1n -k2,2n -k3,3n |
        tail -n 1)
    printf '%s\n' "${latest:-main}"
}

append_path_line() {
    rc_file=$1
    line=$2
    match=$3
    mkdir -p "$(dirname "$rc_file")"
    if [ -f "$rc_file" ] && grep -Fq "$match" "$rc_file" 2>/dev/null; then
        return 1
    fi
    printf '\n# Added by dui installer\n%s\n' "$line" >> "$rc_file"
    return 0
}

ensure_on_path() {
    bin_dir=$1
    case ":${PATH:-}:" in
        *":$bin_dir:"*)
            printf 'Run `dui --version` to verify.\n'
            return
            ;;
    esac
    if [ "${DUI_NO_MODIFY_PATH:-0}" = 1 ]; then
        printf 'Add %s to your PATH to run `dui` directly.\n' "$bin_dir"
        return
    fi

    updated=''
    shell_name=$(basename "${SHELL:-sh}")
    case "$shell_name" in
        zsh)
            if append_path_line "$HOME/.zshrc" "export PATH=\"$bin_dir:\$PATH\"" "$bin_dir"; then
                updated="$HOME/.zshrc"
            fi
            ;;
        bash)
            if append_path_line "$HOME/.bashrc" "export PATH=\"$bin_dir:\$PATH\"" "$bin_dir"; then
                updated="$HOME/.bashrc"
            fi
            if [ "$(uname -s)" = Darwin ] && [ -f "$HOME/.bash_profile" ]; then
                append_path_line "$HOME/.bash_profile" "export PATH=\"$bin_dir:\$PATH\"" "$bin_dir" || true
            fi
            ;;
        fish)
            if append_path_line "$HOME/.config/fish/config.fish" "fish_add_path \"$bin_dir\"" "$bin_dir"; then
                updated="$HOME/.config/fish/config.fish"
            fi
            ;;
        *)
            if append_path_line "$HOME/.profile" "export PATH=\"$bin_dir:\$PATH\"" "$bin_dir"; then
                updated="$HOME/.profile"
            fi
            ;;
    esac

    linked=''
    for candidate in /opt/homebrew/bin /usr/local/bin; do
        case ":${PATH:-}:" in
            *":$candidate:"*)
                if [ -d "$candidate" ] && [ -w "$candidate" ]; then
                    if [ ! -e "$candidate/dui" ] || [ -L "$candidate/dui" ]; then
                        ln -sf "$bin_dir/dui" "$candidate/dui"
                        linked="$candidate/dui"
                        break
                    fi
                fi
                ;;
        esac
    done

    if [ -n "$updated" ]; then
        printf 'Updated %s to include %s on PATH.\n' "$updated" "$bin_dir"
    fi
    if [ -n "$linked" ]; then
        printf 'Linked %s -> %s/dui so `dui` works immediately in this shell.\n' "$linked" "$bin_dir"
    else
        printf 'Restart your shell or run: export PATH="%s:$PATH"\n' "$bin_dir"
    fi
}

main() {
    repo_url=${DUI_REPO_URL:-"https://github.com/de-novo/dui.git"}
    if [ "${1:-}" = --print-ref ]; then resolve_latest_tag "$repo_url"; return; fi
    case $(uname -s) in Darwin|Linux) ;; *) fail "source installation supports macOS and Linux" ;; esac
    for tool in git curl cc; do
        command -v "$tool" >/dev/null 2>&1 || fail "install $tool before running the installer"
    done
    dest=${DUI_INSTALL_DIR:-"$HOME/.local/bin"}
    case $dest in /*) ;; *) dest=$PWD/$dest ;; esac
    [ ! -d "$dest/dui" ] || fail "installation path is a directory: $dest/dui"

    requested_tag=${DUI_TAG:-"${1:-}"}
    if [ -n "$requested_tag" ]; then
        ref=$requested_tag
    else
        ref=$(resolve_latest_tag "$repo_url") || fail "unable to read release tags"
    fi

    work=$(mktemp -d "${TMPDIR:-/tmp}/dui-source.XXXXXXXX")
    case $work in /*) ;; *) work=$PWD/$work ;; esac
    pending=''
    trap 'rm -rf "$work"; if [ -n "$pending" ]; then rm -f "$pending"; fi' EXIT
    trap 'exit 1' HUP INT TERM

    prepare_rust
    prepare_node
    printf 'dui: cloning %s (%s)\n' "$repo_url" "$ref" >&2
    git clone --depth 1 --branch "$ref" "$repo_url" "$work/src"
    cd "$work/src"
    npm ci --include=dev
    npm ci --prefix apps/canvas
    host=$(rustc -vV | sed -n 's/^host: //p')
    [ -n "$host" ] || fail "could not determine the Rust host target"
    cargo build --locked --release --bin dui --target "$host" --target-dir "$work/build"
    binary="$work/build/$host/release/dui"
    "$binary" --version

    mkdir -p "$dest"
    pending=$(mktemp "$dest/.dui.XXXXXXXX")
    install -m 755 "$binary" "$pending"
    mv -f "$pending" "$dest/dui"
    pending=''
    printf 'Installed %s/dui (%s)\n' "$dest" "$ref"
    ensure_on_path "$dest"
}

main "$@" </dev/null
