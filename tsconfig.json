{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "adapters",
    "outDir": "target/typescript",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["adapters/**/*.ts", "adapters/**/*.mts"]
}
